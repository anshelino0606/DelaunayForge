{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "description": "Default build using default generator",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "default",
      "description": "MSVC specific"
    },
    {
      "name": "vs2022",
      "inherits": "msvc-base",
      "description": "Visual Studio 2022 project",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "vs2026",
      "inherits": "msvc-base",
      "description": "Visual Studio 2026 project",
      "generator": "Visual Studio 18 2026"
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },    
    {
      "name": "releaseWithDebugInfo",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "minSizeRel",
      "configurePreset": "default",
      "configuration": "MinSizeRel"
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2022-releaseWithDebugInfo",
      "configurePreset": "vs2022",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "vs2022-minSizeRel",
      "configurePreset": "vs2022",
      "configuration": "MinSizeRel"
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2026-releaseWithDebugInfo",
      "configurePreset": "vs2026",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "vs2026-minSizeRel",
      "configurePreset": "vs2026",
      "configuration": "MinSizeRel"
    }
  ]
}